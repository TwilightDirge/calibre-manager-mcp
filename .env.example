# --- Calibre Manager MCP configuration ---
# Copy this file to `.env` and adjust the paths to your system.
# Alternatively, define these variables in the "env" block of your MCP
# client configuration (Claude Desktop), which is the recommended way.

# Path to your Calibre library (OPTIONAL).
# If omitted, Calibre's default library is used.
# It can also be the Content Server URL, e.g.:
#   http://localhost:8080#library_name
CALIBRE_LIBRARY_PATH=C:\Users\<your-username>\calibre

# Paths to the Calibre executables.
# On Windows they are usually in C:\Program Files\Calibre2\
CALIBREDB_PATH=C:\Program Files\Calibre2\calibredb.exe
EBOOK_CONVERT_PATH=C:\Program Files\Calibre2\ebook-convert.exe
FETCH_EBOOK_METADATA_PATH=C:\Program Files\Calibre2\fetch-ebook-metadata.exe

# Content Server credentials (ONLY if CALIBRE_LIBRARY_PATH is a URL).
# CALIBRE_USERNAME=user
# CALIBRE_PASSWORD=password
